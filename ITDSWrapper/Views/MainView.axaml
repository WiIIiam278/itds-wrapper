<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ITDSWrapper.ViewModels"
             xmlns:c="using:ITDSWrapper.Views.Controls"
             xmlns:g="using:ITDSWrapper.Graphics"
             xmlns:assets="clr-namespace:ITDSWrapper.Assets"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ITDSWrapper.Views.MainView"
             x:DataType="vm:MainViewModel"
             TopLevel.AutoSafeAreaPadding="False"
             Name="View">
    
    <Grid RowDefinitions="Auto,*,Auto,Auto" PointerPressed="MainScreen_OnPointerPressed" 
          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        
        <Image Grid.Row="0" Grid.RowSpan="4" Stretch="UniformToFill" Source="{Binding CurrentBorder}"
               Opacity="{Binding CurrentBorderOpacity}"/>
        <Image Grid.Row="0" Grid.RowSpan="4" Stretch="UniformToFill" Source="{Binding NextBorder}"
               Opacity="{Binding NextBorderOpacity}"/>

        <Grid Row="0" Margin="0 0 23 0" MinHeight="{Binding TopPadding}">
            <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="*" ColumnDefinitions="*" Width="46" Height="46" HorizontalAlignment="Right">
                <Grid.Background>
                    <SvgResourceExtension Path="/Assets/VirtualButtons/MenuButton.svg" Stretch="Fill" AlignmentX="Center" AlignmentY="Center" />
                </Grid.Background>
                <c:VirtualButtonView Grid.Column="0" Grid.Row="0" Margin="0 10 0 0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                     DataContext="{Binding MenuButton}" />
            </Grid>
        </Grid>
        
        <Grid Grid.Row="1" SizeChanged="ScreenGrid_OnSizeChanged">
            <g:EmuImage Name="DsScreen"
                   Source="{Binding CurrentFrame}"
                   Width="{Binding EmuRenderWidth}"
                   MaxHeight="{Binding EmuRenderHeight}"
                   PointerPressed="DsScreen_OnPointerPressed"
                   PointerReleased="DsScreen_OnPointerReleased"
                   PointerMoved="DsScreen_OnPointerMoved"
                   Effect="{Binding ScreenEffect}"/>
        </Grid>
        
        <Grid Grid.Row="2" Name="OnScreenControls" IsVisible="{Binding DisplayVirtualControls}"
              RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="5" Effect="{Binding ScreenEffect}">
            <Grid IsVisible="{Binding IsFullLayout}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" RowDefinitions="*" ColumnDefinitions="*,*,*,*" ColumnSpacing="14" HorizontalAlignment="Center">
                <Grid Grid.Column="0" VerticalAlignment="Center" Width="81" Height="45">
                    <Grid.Background>
                        <SvgResourceExtension Path="/Assets/VirtualButtons/LButton.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                    </Grid.Background>
                    <c:VirtualButtonView VerticalAlignment="Center" DataContext="{Binding LButton}" />
                </Grid>
                <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="81" Height="45">
                    <Grid.Background>
                        <SvgResourceExtension Path="/Assets/VirtualButtons/SelectButton.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                    </Grid.Background>
                    <c:VirtualButtonView HorizontalAlignment="Left" VerticalAlignment="Center" DataContext="{Binding SelectButton}" />
                </Grid>
                <Grid Grid.Column="2" VerticalAlignment="Center" Width="81" Height="45">
                    <Grid.Background>
                        <SvgResourceExtension Path="/Assets/VirtualButtons/StartButton.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                    </Grid.Background>
                    <c:VirtualButtonView HorizontalAlignment="Right" VerticalAlignment="Center" DataContext="{Binding StartButton}" />
                </Grid>
                <Grid  Grid.Column="3" VerticalAlignment="Center" Width="81" Height="45">
                    <Grid.Background>
                        <SvgResourceExtension Path="/Assets/VirtualButtons/RButton.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                    </Grid.Background>
                    <c:VirtualButtonView HorizontalAlignment="Right" VerticalAlignment="Center" DataContext="{Binding RButton}" />
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto" RowDefinitions="Auto" HorizontalAlignment="Center">
                <Grid.Background>
                    <SvgResourceExtension Path="/Assets/VirtualButtons/DPad.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top" />
                </Grid.Background>
                <c:VirtualDPadView DataContext="{Binding Dpad}" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
                <Grid.Background>
                    <SvgResourceExtension Path="/Assets/VirtualButtons/FaceButtons.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top" />
                </Grid.Background>
                <c:VirtualButtonView Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" DataContext="{Binding XButton}" />
                <c:VirtualButtonView Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" DataContext="{Binding YButton}" />
                <c:VirtualButtonView Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" DataContext="{Binding AButton}" />
                <c:VirtualButtonView Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" DataContext="{Binding BButton}" />
            </Grid>
            <Grid IsVisible="{Binding !IsFullLayout}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" RowDefinitions="*" ColumnDefinitions="*" HorizontalAlignment="Center">
                <Grid VerticalAlignment="Center" Width="81" Height="42">
                    <Grid.Background>
                        <SvgResourceExtension Path="/Assets/VirtualButtons/StartButton.svg" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                    </Grid.Background>
                    <c:VirtualButtonView HorizontalAlignment="Right" VerticalAlignment="Center" DataContext="{Binding StartButton}" />
                </Grid>
            </Grid>
        </Grid>
        
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Classes="overlaydimming" 
                IsVisible="{Binding DisplayMenuOverlay}" />
        
        <StackPanel Grid.Row="3" MinHeight="{Binding BottomPadding}"/>
        
        <Grid Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Name="SettingsOverlay" 
              IsVisible="{Binding DisplayMenuOverlay}" Classes="overlaymenucontainer"
              RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="Auto,*" XYFocus.NavigationModes="Enabled"
              XYFocus.UpNavigationStrategy="Projection"
              XYFocus.DownNavigationStrategy="Projection"
              XYFocus.LeftNavigationStrategy="Projection"
              XYFocus.RightNavigationStrategy="Projection">
            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" MinHeight="{Binding TopPadding}"/>
            <Grid Grid.Row="1" IsVisible="{Binding ShowSidebar}" Grid.Column="0" Classes="menu" RowDefinitions="Auto,*,Auto">
                <Grid Classes="menucontainer" Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      Margin="{Binding MenuMargins}" RowSpacing="20">
                    <Label Grid.Row="0" Classes="header" Content="{x:Static assets:Strings.Menu}" />
                    <Button Grid.Row="1" Classes="menuitem" x:Name="FirstMenuItem"
                            Command="{Binding CloseMenuOverlayCommand}"
                            Content="{x:Static assets:Strings.SettingsBackToGame}" 
                            XYFocus.Up="{Binding #LastMenuItem}" />
                    <Button Grid.Row="2" Classes="menuitem" 
                            Command="{Binding OpenDisplaySettingsMenuCommand}"
                            Content="{x:Static assets:Strings.SettingsDisplay}" />
                    <Button Grid.Row="3" Classes="menuitem" 
                            Command="{Binding OpenControllerSettingsMenuCommand}"
                            Content="{x:Static assets:Strings.SettingsController}" />
                    <Button Grid.Row="4" Classes="menuitem" 
                            Command="{Binding OpenAccessibilitySettingsMenuCommand}"
                            Content="{x:Static assets:Strings.SettingsAccessibility}" />
                    <Button Grid.Row="5" Classes="menuitem" 
                            Command="{Binding OpenLegalMenuCommand}"
                            Content="{x:Static assets:Strings.SettingsLegal}" />
                    <Button Grid.Row="6" Classes="menuitem"
                            Command="{Binding OpenSurveyUrlCommand}"
                            Content="{x:Static assets:Strings.SettingsPlayerSurvey}" />
                    <Button Grid.Row="7" Classes="menuitem" 
                            Command="{Binding OpenDiscordUrlCommand}" 
                            Content="{x:Static assets:Strings.SettingsDiscord}" />
                    <Button Grid.Row="8" Classes="menuitem" x:Name="LastMenuItem"
                            Command="{Binding QuitToDesktopCommand}" 
                            IsVisible="{Binding !IsMobile}"
                            Content="{x:Static assets:Strings.SettingsQuitToDesktop}"
                            XYFocus.Down="{Binding #FirstMenuItem}" />
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" Classes="submenu"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="DisplaySettingsMenuOpen" />
                        <Binding Path="ControllerSettingsMenuOpen" />
                        <Binding Path="AccessibilitySettingsMenuOpen" />
                        <Binding Path="LegalMenuOpen" />
                    </MultiBinding>
                </Grid.IsVisible>
                <Grid IsVisible="{Binding DisplaySettingsMenuOpen}" Classes="submenucontainer" RowDefinitions="Auto,*,Auto"
                      RowSpacing="5" ColumnSpacing="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Label Grid.Row="0" Classes="header" Content="{x:Static assets:Strings.SettingsDisplayHeader}" />
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Label Grid.Row="0" Grid.Column="0" Content="{x:Static assets:Strings.WindowStateSettingsLabel}" IsVisible="{Binding !IsMobile}"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="&lt;" Command="{Binding ChangeWindowingSettingsCommand}"
                                CommandParameter="{x:False}" IsVisible="{Binding !IsMobile}"/>
                        <Label Grid.Row="0" Grid.Column="2" Content="{Binding WindowingModeDesc}" IsVisible="{Binding !IsMobile}"/>
                        <Button Grid.Row="0" Grid.Column="3" Content=">" Command="{Binding ChangeWindowingSettingsCommand}"
                                CommandParameter="{x:True}" IsVisible="{Binding !IsMobile}"/>
                        
                        <Label Grid.Row="1" Grid.Column="0" Content="{x:Static assets:Strings.ScreenLayoutLeftRight}" IsVisible="{Binding !IsMobile}"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="&lt;" Command="{Binding ChangeScreenLayoutCommand}"
                                CommandParameter="{x:False}" IsVisible="{Binding !IsMobile}"/>
                        <Label Grid.Row="1" Grid.Column="2" Content="{Binding TargetScreenLayoutDesc}" IsVisible="{Binding !IsMobile}"/>
                        <Button Grid.Row="1" Grid.Column="3" Content=">" Command="{Binding ChangeScreenLayoutCommand}"
                                CommandParameter="{x:True}" IsVisible="{Binding !IsMobile}"/>
                        
                        <Label Grid.Row="2" Grid.Column="0" Content="{x:Static assets:Strings.SettingsBorders}"/>
                        <Button Grid.Row="2" Grid.Column="1" Content="&lt;" Command="{Binding ChangeBorderSettingsCommand}"/>
                        <Label Grid.Row="2" Grid.Column="2" Content="{Binding BordersSettingDesc}"/>
                        <Button Grid.Row="2" Grid.Column="3" Content=">" Command="{Binding ChangeBorderSettingsCommand}"/>
                        
                        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Classes="menuitem"  IsVisible="{Binding IsMobile}"
                                Command="{Binding SettingsBackCommand}"
                                Content="{x:Static assets:Strings.SettingsBack}" />
                    </Grid>
                </Grid>
                <Grid IsVisible="{Binding ControllerSettingsMenuOpen}" Classes="submenucontainer" RowDefinitions="Auto,*,Auto"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Label Grid.Row="0" Classes="header" Content="{x:Static assets:Strings.SettingsControllerHeader}" />
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsVisible="{Binding IsMobile}">
                        <Label Grid.Row="0" Grid.Column="0" Content="{x:Static assets:Strings.SettingsVirtualButtonLayout}"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="&lt;" Command="{Binding ChangeVirtualButtonsLayoutSettingsCommand}"/>
                        <Label Grid.Row="0" Grid.Column="2" Content="{Binding VirtualButtonsLayoutSettingDesc}"/>
                        <Button Grid.Row="0" Grid.Column="3" Content=">" Command="{Binding ChangeVirtualButtonsLayoutSettingsCommand}"/>
                        
                        <Label Grid.Row="1" Grid.Column="0" Content="{x:Static assets:Strings.SettingsControlPadHaptics}"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="&lt;" Command="{Binding ChangeControlPadHapticsSettingsCommand}"/>
                        <Label Grid.Row="1" Grid.Column="2" Content="{Binding VirtualButtonsHapticsSettingDesc}"/>
                        <Button Grid.Row="1" Grid.Column="3" Content=">" Command="{Binding ChangeControlPadHapticsSettingsCommand}"/>
                        
                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Classes="menuitem"  IsVisible="{Binding IsMobile}"
                                Command="{Binding SettingsBackCommand}"
                                Content="{x:Static assets:Strings.SettingsBack}" />
                    </Grid>
                </Grid>
                <Grid IsVisible="{Binding AccessibilitySettingsMenuOpen}" Classes="submenucontainer" RowDefinitions="Auto,*,Auto"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Label Grid.Row="0" Classes="header" Content="{x:Static assets:Strings.SettingsAccessibilityHeader}" />
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Label Grid.Row="0" Grid.Column="0" Content="{x:Static assets:Strings.SettingsScreenReader}"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="&lt;" Command="{Binding ChangeScreenReaderSettingsCommand}"/>
                        <Label Grid.Row="0" Grid.Column="2" Content="{Binding ScreenReaderSettingDesc}"/>
                        <Button Grid.Row="0" Grid.Column="3" Content=">" Command="{Binding ChangeScreenReaderSettingsCommand}"/>
                        
                        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Classes="menuitem"  IsVisible="{Binding IsMobile}"
                                Command="{Binding SettingsBackCommand}"
                                Content="{x:Static assets:Strings.SettingsBack}" />
                    </Grid>
                </Grid>
                <Grid IsVisible="{Binding LegalMenuOpen}" Classes="submenucontainer" RowDefinitions="Auto,*,Auto"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Label Grid.Row="0" Classes="header" Content="{x:Static assets:Strings.SettingsLegal}" />
                    <Grid Grid.Row="1" RowDefinitions="Auto" ColumnDefinitions="Auto,Auto,Auto,Auto"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Classes="menuitem"  IsVisible="{Binding IsMobile}"
                                Command="{Binding SettingsBackCommand}"
                                Content="{x:Static assets:Strings.SettingsBack}" />
                    </Grid>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" MinHeight="{Binding BottomPadding}"/>
        </Grid>
    </Grid>
</UserControl>